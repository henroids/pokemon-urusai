[Unit]
Description=Pokemon Urusai screen reader (RetroArch AI Service on localhost:4404)
After=local-fs.target

[Service]
Type=simple
User=root
WorkingDirectory=@DEST@
ExecStart=/usr/bin/python3 -m urusai.server --port 4404 --capture @CAPTURE@ --settings @SETTINGS@
Restart=on-failure
RestartSec=3
Nice=5

[Install]
WantedBy=multi-user.target
